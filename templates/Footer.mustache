{{! `role` is unnecessary but kept to support selectors in any gadgets or user styles and
	to mitigate a VoiceOver bug. }}
<footer id="footer" class="mw-footer loftia-footer" role="contentinfo" {{{html-user-language-attributes}}}>
	<div class="loftia-footer__text">
		{{#data-info}}{{>FooterList}}{{/data-info}}
		<p class="loftia-footer__disclaimer">{{msg-loftia-disclaimer}}</p>
		{{#data-places}}{{>FooterList}}{{/data-places}}
	</div>
	{{#data-icons}}{{>FooterList}}{{/data-icons}}
</footer>
