{
	"name": "Loftia",
	"version": "1.1.0",
	"author": [
		"Preston Hager"
	],
	"url": "https://github.com/PrestonHager/LoftiaMediaWikiSkin",
	"descriptionmsg": "loftia-skin-desc",
	"namemsg": "skinname-loftia",
	"license-name": "CC0-1.0",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"ValidSkinNames": {
		"loftia": {
			"class": "MediaWiki\\Skins\\Loftia\\SkinLoftia",
			"args": [
				{
					"name": "loftia",
					"supportsMwHeading": true,
					"responsive": true,
					"clientPrefEnabled": true,
					"messages": [
						"sitetitle",
						"search",
						"tagline",
						"navigation-heading",
						"loftia-jump-to-content",
						"loftia-page-tools",
						"loftia-user-menu",
						"loftia-theme-toggle",
						"loftia-disclaimer"
					],
					"styles": [
						"skins.loftia.styles"
					],
					"scripts": [
						"skins.loftia"
					]
				}
			]
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skins\\Loftia\\": "includes/"
	},
	"MessagesDirs": {
		"Loftia": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.loftia.styles": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"normalize": true,
				"elements": true,
				"content-tables": true,
				"content-links": true,
				"content-links-external": true,
				"content-media": true,
				"interface-message-box": true,
				"interface-category": true,
				"interface-edit-section-links": true,
				"toc": true
			},
			"styles": [
				"resources/skin.less"
			]
		},
		"skins.loftia": {
			"packageFiles": [
				"resources/skin.js"
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.user"
			],
			"messages": [
				"loftia-theme-day",
				"loftia-theme-night"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Loftia"
	},
	"ResourceModuleSkinStyles": {
		"loftia": {
			"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less"
		}
	},
	"manifest_version": 2
}
